# === База данных ===
DATABASE_URL=postgresql+asyncpg://nutriagent:nutriagent@localhost:5433/nutriagent
# In AWS, ECS injects these fields from the managed RDS secret instead of DATABASE_URL.
# DB_HOST=database.example.amazonaws.com
# DB_PORT=5432
# DB_NAME=nutriagent
# DB_USER=mealy_admin
# DB_PASSWORD=secret

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === LLM ===
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL_NAME=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL_NAME=openai/gpt-4o
LLM_TIMEOUT_SEC=45
LLM_MAX_OUTPUT_TOKENS=900
LLM_MAX_RETRIES=2
LLM_RETRY_RESPONSE_PREVIEW_CHARS=300
AGENT_MAX_LLM_CALLS=10
AGENT_MAX_SEARCH_CALLS=5

# === Приложение ===
SECRET_KEY=change-me-in-production
ADMIN_EMAILS=admin@example.com
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=true

# === Dev-режим (НИКОГДА не включать в проде) ===
# DEV_MODE=true: запросы без bearer-токена автологинятся как DEV_USER_EMAIL,
# повторный /register с занятым email возвращает existing user, CORS=*.
DEV_MODE=false
DEV_USER_EMAIL=demo@example.com
DEV_USER_PASSWORD=demo123456

# === Frontend ===
PUBLIC_API_BASE_URL=http://localhost:8000
