{
  "name": "mealy-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write --unsafe --error-on-warnings",
    "format": "biome format --write",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.5",
    "astro": "^6.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "typescript": "^5.8.3"
  }
}
